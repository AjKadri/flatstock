# M1 configuration for PLAN-v3 mainnet checks.
# Copy to .env locally and fill values there. Never commit .env.

# Network
CHAIN_ID=4663
RPC_URL=https://rpc.mainnet.chain.robinhood.com
EXPLORER_URL=https://robinhoodchain.blockscout.com

# Self-funded sponsorship order
# M1 first tries the own-relayer path. The user signer signs an EIP-7702
# authorization and the relayer submits the transaction and pays ETH gas.
M1_SPONSOR_MODE=relayer-7702
M1_USER_PRIVATE_KEY=
M1_USER_ADDRESS=
M1_RELAYER_PRIVATE_KEY=
M1_RELAYER_ADDRESS=
M1_7702_IMPLEMENTATION_ADDRESS=

# Optional own ERC-4337 paymaster path.
M1_ENTRYPOINT_VERSION=0.7
M1_ENTRYPOINT_ADDRESS=0x0000000071727De22E5E9d8BAf0edAc6f37da032
M1_PAYMASTER_ADDRESS=
M1_PAYMASTER_DEPLOYER_PRIVATE_KEY=
M1_PAYMASTER_DEPOSIT_WEI=

# Optional free ZeroDev or Pimlico fallback. Use only if the dashboard/API
# confirms that mainnet 4663 is covered without a paid plan.
ZERODEV_PROJECT_ID=
ZERODEV_RPC=
PIMLICO_API_KEY=
PIMLICO_RPC=

# Passkey authentication is a stretch goal. Passkey credentials stay in the
# browser/device and are never placed in this file.
PASSKEY_ORIGIN=http://localhost:3000
PRIVY_APP_ID=

# Swap aggregation. 0x is attempted first when configured. The current M1
# fallback is Uniswap v3 because 0x rejected the NVDA buy token.
ZEROX_API_KEY=
ZEROX_API_VERSION=v2
AGGREGATOR=uniswap-v3-fallback

# Uniswap v3 fallback verified on Robinhood Chain mainnet.
UNISWAP_ROUTER_ADDRESS=0xCaf681a66D020601342297493863E78C959E5cb2
UNISWAP_QUOTER_ADDRESS=0x33e885eD0Ec9bF04EcfB19341582aADCb4c8A9E7
UNISWAP_FEE=500

# Canonical Robinhood Chain assets
WIF_ADDRESS=0x5173b8eA6923c2d40267890D45C46a3480954773
USDG_ADDRESS=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168
STOCK_SYMBOL=NVDA
STOCK_TOKEN_ADDRESS=0xd0601CE157Db5bdC3162BbaC2a2C8aF5320D9EEC
STOCK_FEED_ADDRESS=0x379EC4f7C378F34a1B47E4F3cbeBCbAC3E8E9F15
GAS_PAYMENT_TOKEN_ADDRESS=0x5173b8eA6923c2d40267890D45C46a3480954773

# M1 basket candidates verified against the official public asset registry.
AAPL_TOKEN_ADDRESS=0xaF3D76f1834A1d425780943C99Ea8A608f8a93f9
AAPL_FEED_ADDRESS=0x6B22A786bAa607d76728168703a39Ea9C99f2cD0
AAPL_UNISWAP_FEE=500
MSFT_TOKEN_ADDRESS=0xe93237C50D904957Cf27E7B1133b510C669c2e74
MSFT_FEED_ADDRESS=0x45C3C877C15E6BA2EBB19eA114Ea508d14C1Af2E
MSFT_UNISWAP_FEE=3000
NVDA_UNISWAP_FEE=500

# Core v3 vote evidence. The deployed address is filled only after deployment.
VOTE_CONTRACT_ADDRESS=
VOTE_ROUND_ID=1

# M2 sponsored-buy contracts. These addresses are filled only after deployment.
LOCK_CONTRACT_ADDRESS=
BUY_ROUTER_ADDRESS=
LOCK_MINIMUM_WIF=10000000000000000000
NON_LOCKER_GAS_WIF=10000000000000000
M2_ROUND_ID=2

# This exact notice must be shown anywhere Stock Tokens or prices appear.
STOCK_TOKEN_NOTICE=Not available to US persons. Not investment advice.

# M1 limits
BUY_USDG_AMOUNT=5000000
WEEKLY_LIMIT_USDG=5000000
MAX_SLIPPAGE_BPS=200

# Optional funder for sending tiny test balances to the fresh smart account.
# Use only if you want the harness to sign funding transactions from an
# environment-only key.
# Never put a real value in this file or source control.
M1_FUNDER_PRIVATE_KEY=
M1_FUNDER_ADDRESS=

# The fresh passkey smart-account address is written here only after creation,
# if the harness needs to query it across runs. It is not a secret.
M1_SMART_ACCOUNT_ADDRESS=

