[Unit]
Description=Flat Index relayer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=flat-index
Group=flat-index
WorkingDirectory=/opt/flat-index
EnvironmentFile=/etc/flat-index/flat-index.env
ExecStart=/usr/bin/npm run relay --prefix /opt/flat-index/web
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/flat-index

[Install]
WantedBy=multi-user.target
