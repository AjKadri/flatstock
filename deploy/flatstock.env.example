# Copy to /etc/flatstock/flatstock.env and chmod 600.
# Put real values here only. Never commit the copied file.
NODE_ENV=production
M3_RELAYER_PORT=8788
M3_RELAYER_HOST=127.0.0.1
RPC_URL=https://rpc.mainnet.chain.robinhood.com
# GetBlock Robinhood Chain RPC: tried first for general reads; QuickNode then public RPC are the failover.
GETBLOCK_RPC_URL=
QUICKNODE_RPC_URL=
M1_RELAYER_PRIVATE_KEY=
META_VOTES_ADDRESS=0x4BB945800d588E6B4DB287b3fCe9C13f7825A968
META_ROUTER_ADDRESS=0x8799a2eF390dE8b0Ef97919C7e040C44DdFadbe7
M3_CLOSE_BOT_PRIVATE_KEY=
# Retired vote contract. The close bot uses META_VOTES_ADDRESS first and only falls back to this.
VOTE_CONTRACT_ADDRESS=0x68d2622f3bbf6BE80CdfED679489de344410C7Db
CLOSE_ROUND_FALLBACK_ID=3
# Round bot (flatstock-close-round.timer, every 5 minutes). It works out the current round itself from
# latestRoundId, so no round id or close time is pinned any more.
#   CLOSE_ROUND_ENABLED=0                       status only, never sends
#   CLOSE_ROUND_ENABLED=1, AUTO_OPEN_ENABLED=0  closes the current round once its closesAt has passed
#   CLOSE_ROUND_ENABLED=1, AUTO_OPEN_ENABLED=1  also opens the next weekly round (closesAt + 7 days) when the signer is owner()
# In auto mode VOTE_ROUND_ID and CLOSE_ROUND_EXPECTED_CLOSES_AT are ignored (and logged as ignored); delete them.
CLOSE_ROUND_ENABLED=0
AUTO_OPEN_ENABLED=0
# Relayer stops sponsoring below this balance (0.0003 ETH).
M3_MIN_RELAYER_BALANCE_WEI=300000000000000
M3_DAILY_SPONSORED_TX_CAP=3
M3_RELAYER_KILL_SWITCH=1
M3_RELAYER_ADMIN_TOKEN=
M3_ALLOWED_ORIGIN=https://app.flatstock.ajkadri.dev
